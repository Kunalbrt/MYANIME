<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Watch Anime</title>
  <style>
    body { background: #0f0f0f; color: white; font-family: Arial, sans-serif; margin: 0; padding: 20px; }
    #playerWrapper { width: 100%; max-width: 900px; margin: 0 auto; }
    #playBtn {
      display: block; width: 100%; padding: 16px;
      background: #e50914; color: white; font-size: 18px;
      border: none; border-radius: 8px; cursor: pointer;
    }
    #playBtn:hover { background: #c40812; }
    #playerContainer { display: none; margin-top: 16px; }
    #videoPlayer { width: 100%; height: 500px; border: none; border-radius: 8px; }
    #hlsPlayer { width: 100%; height: 500px; border-radius: 8px; background: black; }
    #status { margin-top: 10px; color: #aaa; font-size: 14px; text-align: center; }
  </style>

  <!-- HLS.js for m3u8 streams -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.4.12/hls.min.js"></script>
</head>
<body>

<div id="playerWrapper">
  <h2 id="animeTitle">Naruto - Episode 1</h2>

  <button id="playBtn" onclick="loadPlayer()">▶ Watch Now</button>
  <div id="status"></div>

  <div id="playerContainer">
    <!-- Used for m3u8 HLS streams -->
    <video id="hlsPlayer" controls style="display:none;"></video>

    <!-- Used for embed iframe fallback -->
    <iframe id="iframePlayer" style="display:none;"
      allowfullscreen allow="autoplay; fullscreen"></iframe>
  </div>
</div>

<script>
  // ─── CONFIG ───────────────────────────────────────
  // Set these dynamically from your backend/template
  const ANIME_SLUG = 'naruto';   // e.g. passed from server
  const EPISODE_INDEX = 0;       // 0 = episode 1
  // ──────────────────────────────────────────────────

  async function loadPlayer() {
    const btn = document.getElementById('playBtn');
    const status = document.getElementById('status');

    btn.disabled = true;
    btn.innerText = '⏳ Loading...';
    status.innerText = 'Fetching stream URL...';

    try {
      const res = await fetch(`/api/stream/${ANIME_SLUG}/${EPISODE_INDEX}`);
      const data = await res.json();

      if (!data.success) throw new Error('Stream fetch failed');

      document.getElementById('playerContainer').style.display = 'block';
      btn.style.display = 'none';
      status.innerText = '';

      if (data.type === 'm3u8') {
        // Play HLS stream using HLS.js
        const video = document.getElementById('hlsPlayer');
        video.style.display = 'block';

        if (Hls.isSupported()) {
          const hls = new Hls();
          hls.loadSource(data.url);
          hls.attachMedia(video);
          hls.on(Hls.Events.MANIFEST_PARSED, () => video.play());
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          // Native HLS support (Safari)
          video.src = data.url;
          video.play();
        }

      } else {
        // Fallback: embed iframe
        const iframe = document.getElementById('iframePlayer');
        iframe.style.display = 'block';
        iframe.style.width = '100%';
        iframe.style.height = '500px';
        iframe.style.border = 'none';
        iframe.src = data.url;
      }

    } catch (err) {
      status.innerText = '❌ Failed to load stream. Try again.';
      btn.disabled = false;
      btn.innerText = '▶ Watch Now';
      console.error(err);
    }
  }
</script>

</body>
</html>